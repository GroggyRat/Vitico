{
  "name": "vitico",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @vitico/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @vitico/db generate",
    "db:migrate": "pnpm --filter @vitico/db migrate:dev",
    "db:deploy": "pnpm --filter @vitico/db migrate:deploy",
    "db:seed": "pnpm --filter @vitico/db seed",
    "db:reset": "pnpm --filter @vitico/db reset"
  }
}
