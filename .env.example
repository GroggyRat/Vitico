# Postgres (docker compose up -d postgres)
DATABASE_URL=postgresql://vitico:vitico@localhost:5432/vitico

# Public base URL of the web app (used in invite / email links)
APP_URL=http://localhost:3000

# Separate database for integration tests (wiped on every run)
TEST_DATABASE_URL=postgresql://vitico:vitico@localhost:5432/vitico_test

# ─── Files (payment receipts) ───
# Set to store uploads in S3; otherwise they go to apps/web/.uploads
# S3_BUCKET=vitico-uploads

# ─── Notifications (delivered by `pnpm --filter @vitico/web worker`) ───
# "ses" to send through Amazon SES; anything else logs emails to the worker console.
EMAIL_PROVIDER=log
EMAIL_FROM="VITICO Wholesale <orders@example.com>"
# SES_CONFIGURATION_SET=
# "sns" (Amazon SNS) or "twilio"; anything else logs SMS.
SMS_PROVIDER=log
# SMS_SENDER_ID=VITICO
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# Web push: generate with `npx web-push generate-vapid-keys`
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# Set to 1 to refresh indicative exchange rates daily
FX_AUTO_REFRESH=0
