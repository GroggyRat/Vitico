    "typecheck": "tsc --noEmit",
    "truncate": "tsx prisma/truncate.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.5",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
